{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BatterMC5Remake",
  "version": "1.1.0",
  "identifier": "cn.battermc.launcher",
  "build": {
    "frontendDist": "../../sidecar/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BatterMC5Remake",
        "width": 940,
        "height": 600,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/battermc-backend"],
    "icon": ["../../sidecar/icon.ico"]
  }
}
