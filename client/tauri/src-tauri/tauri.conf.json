{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BMC [Remake]",
  "version": "../package.json",
  "identifier": "cn.battermc.launcher",
  "build": {
    "frontendDist": "../../sidecar/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minecraft",
        "width": 940,
        "height": 600,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "../../sidecar/icon.ico"
      }
    },
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/battermc-backend"
    ],
    "icon": [
      "../../sidecar/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/msquic.dll": "msquic.dll"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRjA2Qjc0MDg3MUNDRTUKUldUbHpIRUlkR3Z3ZkprWFZmR0ZGMzJ6KzVuMCs4RXVWTG5vanpIKzNHTnFtVmFWSVZ3NXB2eFoK",
      "endpoints": [
        "https://mc.muxigame.com/api/v1/launcher/updater/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
