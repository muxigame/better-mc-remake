{
  "root": "__SET_WITH_--root__",
  "pack": {
    "id": "battermc5remake",
    "name": "BatterMC5Remake",
    "version": "1.3.6",
    "changelog": "1.3.6\n- 视角切换只保留第一人称和越肩视角，关掉原版的前后两个第三人称\n- 自动第三人称改为可选组件，默认不安装\n- 更真实的第一人称模型改为可选组件，默认不安装\n  （两项都可以在启动器的可选内容里随时勾选）"
  },
  "minecraft": {
    "version": "1.21.1",
    "loader": "neoforge",
    "loaderVersion": "21.1.250",
    "versionJson": "versions/BatterMC5Remake/BatterMC5Remake.json",
    "versionId": "BatterMC5Remake"
  },
  "java": {
    "major": 21,
    "min": "21.0.0",
    "image": "jre",
    "distribution": "temurin",
    "size": 0
  },
  "servers": [
    {
      "name": "Batter MC 5",
      "host": "110.42.51.3",
      "port": 25565,
      "primary": true,
      "forced": true,
      "routes": [
        {
          "id": "cn-relay-current",
          "label": "国内服务器兜底",
          "kind": "Relay",
          "transport": "tcp",
          "host": "110.42.51.3",
          "port": 25565,
          "priority": 0,
          "probeTimeoutMs": 1800
        }
      ]
    }
  ],
  "include": [
    {
      "glob": "mods/[自动第三人称]auto_third_person-neo-1.21.1-2.2.jar",
      "policy": "Optional",
      "group": "视角",
      "label": "自动第三人称（骑乘、滑翔等场景自动切第三人称）"
    },
    {
      "glob": "mods/[更真实的第一人称模型]firstperson-neoforge-2.7.2-mc1.21.1.jar",
      "policy": "Optional",
      "group": "视角",
      "label": "更真实的第一人称模型（低头能看到自己身体）"
    },
    {
      "glob": "mods/**",
      "policy": "Managed"
    },
    {
      "glob": "config/**",
      "policy": "Seed"
    },
    {
      "glob": "defaultconfigs/**",
      "policy": "Seed"
    },
    {
      "glob": "configureddefaults/**",
      "policy": "Seed"
    },
    {
      "glob": "options.txt",
      "policy": "Seed"
    },
    {
      "glob": "shaderpacks/**",
      "policy": "Seed"
    },
    {
      "glob": "resourcepacks/**",
      "policy": "Managed"
    },
    {
      "glob": "kubejs/**",
      "policy": "Managed"
    },
    {
      "glob": "tlm_custom_pack/**",
      "policy": "Managed"
    },
    {
      "glob": "fancymenu_data/**",
      "policy": "Seed"
    },
    {
      "glob": "versions/**",
      "policy": "Managed"
    }
  ],
  "exclude": [
    "logs/**",
    "saves/**",
    "crash-reports/**",
    "local/**",
    "libraries/**",
    "assets/**",
    "launcher/**",
    "runtime/**",
    "**/*.part"
  ],
  "prune": [
    "mods"
  ],
  "overlays": [
    {
      "path": "config/iris.properties",
      "format": "Properties",
      "enforce": {
        "maxShadowRenderDistance": 16,
        "disableUpdateMessage": true
      },
      "createIfMissing": true
    },
    {
      "path": "options.txt",
      "format": "Properties",
      "enforce": {
        "skipMultiplayerWarning": true,
        "key_iris.keybind.reload": "key.keyboard.unknown"
      },
      "removeFromList": {
        "resourcePacks": [
          "mod/pasterdream:packs/paster_vanilla_ui",
          "builtin/paster_vanilla_ui"
        ]
      },
      "createIfMissing": false
    },
    {
      "path": "config/shouldersurfing-client.toml",
      "format": "Toml",
      "enforce": {
        "perspective/third_person_front_enabled": false,
        "perspective/third_person_back_enabled": false
      },
      "createIfMissing": false
    },
    {
      "path": "config/PasterDream-Client.toml",
      "format": "Toml",
      "enforce": {
        "HUD/enable mod ui": false,
        "HUD/paster health hud": false
      },
      "createIfMissing": false
    }
  ],
  "externalDownloads": {
    "mods/simplenicknames-1.21.1-neoforge-0.8.0.jar": {
      "url": "https://cdn.modrinth.com/data/EmdnQtis/versions/kVVMxHOA/simplenicknames-1.21.1-neoforge-0.8.0.jar",
      "sha1": "fd762aac2257fb7af50a483cfba004741f38ab44"
    }
  }
}
