# Website / API
BMC_PUBLIC_URL=https://mc.muxigame.com
BMC_OSS_BASE_URL=https://muxigame-prod-static-cn.oss-cn-hangzhou.aliyuncs.com/bmc/release/latest
# 客户端 latest 只是一份小型指针元数据；历史二进制位于 bmc/client/releases/<version>/。
BMC_CLIENT_LATEST_URL=https://muxigame-prod-static-cn.oss-cn-hangzhou.aliyuncs.com/bmc/client/latest/metadata.json
# 可单独覆盖，便于以后从 OSS 迁移到 COS / R2，而无需改客户端。
# 未设置时分别由 BMC_OSS_BASE_URL + manifest.json / files 推导。
BMC_MANIFEST_URL=
BMC_FILES_BASE_URL=
BMC_DATABASE_PATH=server/data/battermc.db
BMC_ENABLE_DOCS=0

# Unified identity. The secret must match muxi-auth's better-mc-web client.
BMC_AUTH_ISSUER=https://account.muxigame.com
BMC_AUTH_CLIENT_ID=better-mc-web
BMC_AUTH_CLIENT_SECRET=
BMC_AUTH_REDIRECT_URI=https://mc.muxigame.com/api/v1/auth/callback

# OP downlink uses the existing game-service trust only after explicit rollout.
# Leave disabled until the matching Core build and approved server config are ready.
BMC_GAME_OP_SYNC_ENABLED=0
# BMC_GAME_SERVICE_KEY must be an existing protected credential (at least 32 chars).
# Keep disabled until auth, matching client/server Core and child-view integration pass.
BMC_TERMINAL_SSO_ENABLED=0
# Never persist MUXI_TERMINAL_GAME_CREDENTIAL; only the launcher injects it per process.
