# Website / API
BMC_PUBLIC_URL=https://mc.muxigame.com
BMC_OSS_BASE_URL=https://muxigame-prod-static-cn.oss-cn-hangzhou.aliyuncs.com/bmc/release/latest
BMC_DATABASE_PATH=server/data/battermc.db
BMC_ENABLE_DOCS=0

# Transactional email (recommended: Alibaba Cloud DirectMail SMTP)
BMC_SMTP_HOST=smtpdm.aliyun.com
BMC_SMTP_PORT=465
BMC_SMTP_SSL=1
BMC_SMTP_USERNAME=no-reply@muxigame.com
BMC_SMTP_PASSWORD=
BMC_SMTP_FROM="Batter MC Remake <no-reply@muxigame.com>"

# Local development only. Never enable in production.
BMC_AUTH_DEV_VERIFY=0
